# External MySQL server IP or hostname. For MySQL on the Docker host use host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
# Single quotes keep dollar signs in passwords literal.
DB_PASSWORD='replace-with-server-password'
DB_NAME=hospital_management
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
APP_PORT=3000

# Comma-separated allowed browser origins (scheme + hostname + optional port; no trailing slash).
CORS_ORIGINS=http://localhost:3000
